# Environment Configuration for Session Hijacking Detection Backend
APP_NAME="Behavioral Fingerprint Session Hijacking Detection"
ENVIRONMENT="development"
DEBUG=True
SECRET_KEY="insecure-dev-secret-key-change-in-production-only-use-32-bytes"

# Database Configuration
DATABASE_URL="sqlite:///./data/session_security.db"

# Session Settings
SESSION_COOKIE_NAME="sid"
CSRF_COOKIE_NAME="csrf_token"
CSRF_HEADER_NAME="x-csrf-token"
SESSION_LIFETIME_SECONDS=3600
COOKIE_SECURE=False  # Set to True in HTTPS production
COOKIE_SAMESITE="lax"
COOKIE_HTTPONLY=True

# Fingerprint Detection Thresholds (0-100 scale)
MISMATCH_FLAG_THRESHOLD=35.0
MISMATCH_REVOKE_THRESHOLD=50.0
SIMILARITY_MIN_THRESHOLD=50.0

# Minimum evidence policy: minimum required comparable attributes
MIN_EVIDENCE_COUNT=5

# CORS Origins
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173", "http://localhost:5174", "http://127.0.0.1:5174", "http://localhost:5175", "http://127.0.0.1:5175", "http://localhost:3000"]

